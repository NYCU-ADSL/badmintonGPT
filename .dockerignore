# Keep the build context small + deterministic. The image builds nanobot from
# vendor/nanobot/ and copies only the code/config it needs.
.git/
.venv/
data/                      # DB is mounted at runtime / built by the ingest profile, never baked in
.env
**/.env
__pycache__/
*.pyc
*.pyo

# Docs site + its build output (separate Cloudflare Pages deliverable)
docs-site/
example-mcp-server/

# Host-only dev tooling (the image builds the dist from vendor/nanobot instead).
scripts/

# badminton-db is its own image (build context mcps/badminton-db/); the gateway only
# needs mcps/util/, so keep the db package out of the gateway build context.
mcps/badminton-db/

# Never pull a stray vendored node_modules / build artifact into the context
vendor/**/node_modules/
vendor/**/dist/

# Full-tree-vendored upstream extras: kept in git for clean subtree merges, but the wheel
# only packages nanobot/** + bridge + the rebuilt dist, so they bloat the build context for nothing.
vendor/nanobot/tests/
vendor/nanobot/docs/
vendor/nanobot/case/
vendor/nanobot/images/
vendor/nanobot/.github/
vendor/nanobot/.agent/
vendor/nanobot/webui/src/tests/
