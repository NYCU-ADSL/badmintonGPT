# Gatus stack secrets — copy to .env (git-ignored) and fill in.
#   cp .env.example .env

# Cloudflare connector token for the dedicated `badmintongpt-status` tunnel
# (Zero Trust -> Networks -> Tunnels -> badmintongpt-status -> copy token). cloudflared reads it.
TUNNEL_TOKEN=eyJ...

# Reuse the existing reels Cloudflare Access service token (copy from the repo root ../../.env).
# Used as CF-Access-Client-Id / CF-Access-Client-Secret headers on the reels MCP monitor.
REELS_CF_CLIENT_ID=xxxxxxxxxxxxxxxx.access
REELS_CF_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CoachAI bearer token for the badminton-analyze MCP monitor (copy from ../../.env).
# Unlike the other remote MCPs this one is not behind Cloudflare Access — it authenticates
# with an Authorization: Bearer header.
ANALYZE_MCP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
