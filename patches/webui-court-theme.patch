+
+  /* ===== 淡綠場館 — court-line backdrop + Ball-in drop (CourtBackdrop.tsx) =====
+     Decorative court lines behind the thread. Solid white "L" on the empty/home
+     state; translucent framing lines (lower opacity, so they don't fight text)
+     on the chat state. Dark mode swaps to glowing pale-green lines + a bottom
+     court-light glow. The Ball-in drop (ball + ripple + IN) is mounted by
+     ``CourtBackdrop`` only after the composer textarea is CLICKED (React state in
+     ``ThreadViewport``, on pointer-down — not focus, since the composer
+     auto-focuses on mount; and not ``:focus-within``, which reverts on blur). On
+     mount the ball drops in, the ripple expands and fades, and the IN chip pops.
+     The ball and the IN chip are then LEFT on the court and do not disappear. */
+  .court-line {
+    position: absolute;
+    background: #fff;
+  }
+  .dark .court-line {
+    background: rgba(150, 240, 195, 0.9);
+    box-shadow: 0 0 14px rgba(80, 220, 150, 0.55);
+  }
+  .court-line-soft {
+    position: absolute;
+    background: rgba(255, 255, 255, 0.42);
+  }
+  .dark .court-line-soft {
+    background: rgba(180, 245, 215, 0.28);
+    box-shadow: 0 0 14px rgba(80, 220, 150, 0.25);
+  }
+  /* home (empty) geometry — baseline + service line form a bottom-right L */
+  .court-h-base {
+    left: 0;
+    right: 0;
+    top: 64%;
+    height: 32px; /* 2x the 16px ball */
+    box-shadow: 0 1px 0 rgba(20, 60, 40, 0.05);
+  }
+  .court-v-base {
+    left: 30%;
+    top: calc(64% + 32px);
+    bottom: 0;
+    width: 32px;
+  }
+  /* chat geometry — horizontal line above content (full width), vertical line at
+     the left gutter of the message column */
+  .court-h-top {
+    left: 0;
+    right: 0;
+    top: 0;
+    height: 32px;
+  }
+  .court-v-left {
+    left: -3rem; /* sit in the left gutter, ~16px clear of the message column */
+    top: 0;
+    bottom: 0;
+    width: 32px;
+  }
+  /* bottom court-light glow (dark only) */
+  .court-glow {
+    position: absolute;
+    inset: 0;
+    pointer-events: none;
+    opacity: 0;
+  }
+  .dark .court-glow {
+    opacity: 1;
+    background: radial-gradient(120% 80% at 50% 100%, rgba(30, 157, 101, 0.16), transparent 60%);
+  }
+  /* Ball-in drop — hidden until the composer is focused (home state only) */
+  .court-drop {
+    position: absolute;
+    left: 71%;
+    top: calc(64% + 16px);
+    width: 0;
+    height: 0;
+    pointer-events: none;
+  }
+  /* the shuttle drops in once when the home court mounts, then is LEFT resting on
+     the baseline — opacity is 1 and its visibility is independent of focus, so the
+     ball never disappears after it lands (only the ripple + IN judgment are transient) */
+  .court-drop__ball {
