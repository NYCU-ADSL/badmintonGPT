+    <script>
+      // The splash is a fixed overlay above #root, so React mounting cannot
+      // cut the intro off. It leaves only after BOTH the lock-on intro has
+      // played once (the frame's boot-snap animation ends) AND the app has
+      // mounted into #root.
+      (function () {
+        var splash = document.getElementById("boot-splash");
+        var root = document.getElementById("root");
+        if (!splash || !root) return;
+
+        var reduced = false;
+        try {
+          reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+        } catch {}
+
+        var introDone = reduced;
+        var appMounted = false;
+        var leaving = false;
+
+        function leave() {
+          if (leaving) return;
+          leaving = true;
+          if (reduced) {
+            splash.remove();
+            return;
+          }
+          splash.classList.add("boot-splash-leave");
+          splash.addEventListener(
+            "transitionend",
+            function () {
+              splash.remove();
+            },
+            { once: true }
+          );
+          // Safety net in case transitionend never fires.
+          setTimeout(function () {
+            if (splash.parentNode) splash.remove();
+          }, 700);
+        }
+
+        function maybeLeave() {
+          if (introDone && appMounted) leave();
+        }
+
+        splash.addEventListener("animationend", function (event) {
+          if (event.animationName === "boot-snap") {
+            introDone = true;
+            maybeLeave();
+          }
+        });
+        // Safety net: the intro ends at ~2.2s; never hold the app past 2.8s.
+        setTimeout(function () {
+          introDone = true;
+          maybeLeave();
+        }, 2800);
+
+        if (root.childElementCount > 0) {
+          appMounted = true;
+          maybeLeave();
+        } else {
+          new MutationObserver(function (mutations, observer) {
+            if (root.childElementCount > 0) {
+              appMounted = true;
+              observer.disconnect();
+              maybeLeave();
+            }
+          }).observe(root, { childList: true });
+        }
+      })();
+    </script>
