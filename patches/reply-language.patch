+_UI_LOCALE_NAMES: dict[str, str] = {
+    "en": "English",
+    "zh-CN": "Simplified Chinese (简体中文)",
+    "zh-TW": "Traditional Chinese (繁體中文)",
+    "fr": "French (Français)",
+    "ja": "Japanese (日本語)",
+    "ko": "Korean (한국어)",
+    "es": "Spanish (Español)",
+    "vi": "Vietnamese (Tiếng Việt)",
+    "id": "Indonesian (Bahasa Indonesia)",
+}
+
+
 class TurnState(Enum):
     RESTORE = auto()
