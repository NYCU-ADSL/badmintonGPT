# Copy to .env and fill in. Loaded before running the server / tunnel.

# --- server ---
MCP_HOST=127.0.0.1                 # bind localhost; expose via Cloudflare Tunnel
MCP_PORT=8900
PUBLIC_BASE_URL=https://example-mcp.<your-zone>   # used to build downloadable file URLs

# --- consuming/testing the deployed server (Cloudflare Access service token) ---
# Each remote MCP gets its own token pair; name it per server: <NAME>_CF_CLIENT_ID/SECRET
EXAMPLE_CF_CLIENT_ID=
EXAMPLE_CF_CLIENT_SECRET=
