# BadmintonGPT 環境變數範本 —— 複製成 .env 後填入實際值
#   cp .env.example .env
# 由 scripts/load_env.sh 載入，供 ~/.nanobot/config.json 的 ${VAR} 解析。
# 注意：金鑰只從本專案 .env 讀取，不會退回其他專案。

# --- OpenAI（Agent LLM，必填）---
OPENAI_API_KEY=sk-...

# --- Cloudflare Access service token：每個 remote MCP 各一組（做法 A）---
# badminton-reels（config.json 用 ${REELS_CF_CLIENT_ID/SECRET}）
REELS_CF_CLIENT_ID=xxxxxxxxxxxxxxxx.access
REELS_CF_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 第二個 remote MCP（config.json 用 ${OTHER_CF_CLIENT_ID/SECRET}）；不需要就留空/刪除
# OTHER_CF_CLIENT_ID=
# OTHER_CF_CLIENT_SECRET=

# --- 選填（皆有預設值；通常不用設）---
# 本專案根目錄（預設即專案路徑）
# BADMINTONGPT_HOME=/mnt/ssd1/howchien/badmintonGPT
# SQLite DB 路徑（ingest.py / db_mcp 預設 = $BADMINTONGPT_HOME/data/badminton.db）
# BADMINTON_DB=/mnt/ssd1/howchien/badmintonGPT/data/badminton.db
# badminton-reels 原始碼（ingest.py 重用其解析；預設如下）
# REELS_SRC=/mnt/ssd1/howchien/badminton-reels/src
# 逐拍 CSV 來源資料夾（預設如下）
# REELS_DATA_DIR=/mnt/ssd1/howchien/badminton-reels/data/Data
