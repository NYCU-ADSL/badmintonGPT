# BadmintonGPT 環境變數範本 —— 複製成 .env 後填入實際值
#   cp .env.example .env
# 兩種用法都讀這個檔：
#   (a) Docker Compose 部署（docs/DEPLOY.md）—— docker compose 直接以 ${VAR} 帶入。
#   (b) 本機 host 模式（README.md）—— scripts/load_env.sh 載入，供 ~/.nanobot/config.json 解析。
# 注意：金鑰只從本專案 .env 讀取，不會退回其他專案。

# --- OpenAI（Agent LLM，必填）---
OPENAI_API_KEY=sk-...
# Agent 預設模型（nanobot/config.json 用 ${NANOBOT_MODEL}）。裸名，不要加 provider 前綴。
# 未設時 host 模式（load_env.sh）/ Docker（compose）都會 fallback 成 gpt-5.5。
NANOBOT_MODEL=gpt-5.5

# --- 額外的 Custom model preset（選填；預設仍用上面的 GPT-5.5）---
# 在 nanobot/config.json 接成 providers.custom（OpenAI-相容端點）+ model_presets.custom，
# WebUI Settings 的模型選單會多一個「Custom (.env)」可切換。三個都填好該 preset 才能用；
# 不用就留空。nanobot 對「未設」的 ${VAR} 會報錯（空字串不會），故 load_env.sh/compose 都給空 fallback。
# CUSTOM_MODEL_API_BASE=https://your-endpoint/v1   # openai SDK base_url（含 /v1）
# CUSTOM_MODEL_API_KEY=sk-...
# CUSTOM_MODEL_API_MODEL=your-model-name           # 裸模型名，不要加 provider 前綴

# --- Message TTS（WebUI 朗讀按鈕；選填）---
# 只給 gateway 用，不會進前端 bundle：瀏覽器呼叫同源 /api/tts，由 gateway 代理到 TTS 服務並注入金鑰。
# 不填則朗讀按鈕回 503（功能關閉）。
TTS_API_KEY=sk-...
# WebUI「自動準備語音」預設：true = 回覆完成即先產生語音（按播放秒播）；false（預設）= 只在按下喇叭鍵才產生。
# 透過 bootstrap 帶給前端當預設；各瀏覽器仍可在 Settings → 語音 切換覆寫。
TTS_AUTO_PREFETCH=false
# 選填覆寫（皆有預設值）：
# TTS_API_BASE=https://llm.andyjjrt.cc/v1   # openai SDK base_url（會自動接 /audio/speech）
# TTS_API_MODEL=DGX/Qwen3-TTS
# TTS_DEFAULT_VOICE=chris  # 同時是 WebUI 語音下拉的預設
# 延遲調校（proxy 非串流、合成耗時 ~0.1 秒/字）：前端把每則回覆切成 TTS_SEGMENT_CHARS 字一段
# （經 bootstrap 帶給瀏覽器），越小越快出聲。預設 60 字 ≈ 首聲 ~6 秒。改完 `docker compose up -d`
# 即可（不必 rebuild image）。約束：TTS_SEGMENT_CHARS <= TTS_MAX_INPUT_CHARS（超過 server 會回 413）。
# TTS_SEGMENT_CHARS=60      # 每段字數；~0.1 秒/字，故 60→~6s、100→~10s
# TTS_MAX_INPUT_CHARS=300   # server 端單段上限（~0.1 秒/字下，60s timeout 約對應 ~600 字）
# TTS_TIMEOUT_S=60          # gateway 呼叫上游 TTS 的逾時秒數

# --- Cloudflare Access service token：每個 remote MCP 各一組（做法 A）---
# badminton-reels（config.json 用 ${REELS_CF_CLIENT_ID/SECRET}）
REELS_CF_CLIENT_ID=xxxxxxxxxxxxxxxx.access
REELS_CF_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# badminton-video-retrieval（config.json 用 ${VIDEO_RETRIEVAL_CF_CLIENT_ID/SECRET}）
VIDEO_RETRIEVAL_CF_CLIENT_ID=xxxxxxxxxxxxxxxx.access
VIDEO_RETRIEVAL_CF_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# badminton-analyze（CoachAI，config.json 用 ${ANALYZE_MCP_TOKEN}）
# 例外：這台不是 Cloudflare Access，而是自己的 bearer token，所以不用 <NAME>_CF_CLIENT_ID/SECRET
# 命名。少了它 gateway 會在啟動時因為未設定的 ${VAR} 而報錯。
ANALYZE_MCP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Docker Compose 部署用（docs/DEPLOY.md；host 模式不需要）---
# Cloudflare 遠端管理 tunnel 的 connector token（Zero Trust → Networks → Tunnels 建立後複製）。
# ingress（badmintongpt.<zone> → http://gateway:8765）與 public hostname 設在 Cloudflare 後台。
TUNNEL_TOKEN=eyJ...
# 對外網域（僅供文件/驗證參考；實際 ingress 在後台設定）
BADMINTONGPT_HOSTNAME=badmintongpt.<your-zone>

# --- 只有建 DB（ingest profile）時需要；gateway 執行期不需要 ---
# HuggingFace token（下載 howard9199/Badminton 資料集的逐拍 CSV）。
# ingest 現在自帶解析程式（mcps/badminton-db/ingest_lib/），不再需要 badminton-reels 原始碼。
HF_TOKEN=hf_...

# --- 選填（皆有預設值；通常不用設）---
# 本專案根目錄（預設即專案路徑）
# BADMINTONGPT_HOME=/mnt/ssd1/howchien/badmintonGPT
# SQLite DB 路徑（ingest.py / db MCP 預設 = $BADMINTONGPT_HOME/data/badminton.db）
# BADMINTON_DB=/mnt/ssd1/howchien/badmintonGPT/data/badminton.db
# parity 測試用 badminton-reels 原始碼/資料路徑（mcps/badminton-db/scripts/test_decouple_parity.py；可選）
# REELS_SRC=/mnt/ssd1/howchien/badminton-reels/src
# REELS_DATA=/mnt/ssd1/howchien/badminton-reels/data/Data
